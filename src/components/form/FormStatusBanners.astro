---
interface Props {
  successMessage: string;
}

const { successMessage } = Astro.props;
---

<div
  class="mb-6 hidden rounded-2xl border border-[var(--color-success)]/30 bg-[var(--color-success)]/10 p-4"
  data-form-success
  role="status"
  aria-live="polite"
>
  <p class="font-semibold text-[var(--color-ink)]">{successMessage}</p>
</div>

<div
  class="mb-6 hidden rounded-2xl border border-red-300 bg-red-50 p-4"
  data-form-error
  role="alert"
  aria-live="assertive"
>
  <p class="font-semibold text-[var(--color-ink)]">The form could not be submitted.</p>
  <p class="mt-2 text-sm" data-form-error-message>Please try again or email ISS directly.</p>
</div>
