---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '@/lib/paths';

interface Props {
  capabilities: CollectionEntry<'capabilities'>[];
}

const { capabilities } = Astro.props;
---

<section class="section-space">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="fade-up mb-8 space-y-2">
      <p class="eyebrow">At a glance</p>
      <h2 class="text-3xl md:text-4xl">Select a capability to preview.</h2>
    </div>

    <div class="space-y-3 stagger-children">
      {capabilities.map((cap) => {
        const cardId = `showcase-${cap.id}`;
        return (
          <div data-accordion-card class="fade-up rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]">
            <button
              data-accordion-header
              aria-expanded="false"
              aria-controls={`${cardId}-body`}
              class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left"
            >
              <h3 class="text-base font-semibold text-[var(--color-ink)]">{cap.data.title}</h3>
              <svg
                class="accordion-chevron h-5 w-5 flex-shrink-0 text-[var(--color-primary)]"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id={`${cardId}-body`} class="accordion-body" aria-hidden="true">
              <div class="overflow-hidden">
                <div class="space-y-5 px-5 pb-5">
                  <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">{cap.data.summary}</p>

                  <div class="space-y-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">Key outcomes</p>
                    {cap.data.outcomes.slice(0, 3).map((outcome) => (
                      <p class="flex items-start gap-3 text-sm">
                        <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
                        <span class="text-[var(--color-ink)]">{outcome}</span>
                      </p>
                    ))}
                  </div>

                  <a
                    href={withBase(`/capabilities/${cap.id}`)}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition hover:text-[var(--color-secondary)]"
                  >
                    Explore capability
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
