---
import type { NavigationItem } from '@/types/site';
import { brand } from '@/data/brand';
import { withBase } from '@/lib/paths';

interface Props {
  items: NavigationItem[];
}

const { items } = Astro.props as Props;
---

<div class="lg:hidden" data-mobile-nav-root>
  <button
    type="button"
    aria-expanded="false"
    class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-white text-[var(--color-ink)] shadow-sm"
    data-mobile-nav-toggle
  >
    <span class="sr-only">Toggle navigation</span>
    <span class="flex flex-col gap-1.5" aria-hidden="true">
      <span class="h-0.5 w-5 bg-current transition-transform duration-200" data-mobile-nav-line="top" />
      <span class="h-0.5 w-5 bg-current transition-opacity duration-200" data-mobile-nav-line="middle" />
      <span class="h-0.5 w-5 bg-current transition-transform duration-200" data-mobile-nav-line="bottom" />
    </span>
  </button>

  <div
    class="fixed inset-0 z-50 hidden bg-[rgba(17,34,53,0.7)] px-5 py-6 backdrop-blur-sm"
    data-mobile-nav-panel
  >
    <div class="panel ml-auto flex max-w-sm flex-col gap-6 p-6">
      <div class="flex items-center justify-between">
        <span class="font-semibold uppercase tracking-[0.16em] text-[var(--color-secondary)]">
          Navigation
        </span>
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-ink)]"
          data-mobile-nav-close
        >
          <span class="sr-only">Close navigation</span>
          &times;
        </button>
      </div>

      <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
        {items.map((item) =>
          item.children ? (
            <div data-mobile-nav-group>
              <button
                type="button"
                class="flex w-full items-center justify-between rounded-2xl px-4 py-3 text-lg font-semibold text-[var(--color-ink)] transition hover:bg-[var(--color-surface-muted)]"
                data-mobile-nav-group-toggle
                aria-expanded="false"
              >
                {item.label}
                <svg
                  class="h-4 w-4 text-[var(--color-ink-soft)] transition-transform duration-200"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="hidden pl-4" data-mobile-nav-group-panel>
                {item.children.map((child) => (
                  <a
                    href={withBase(child.href)}
                    class:list={[
                      'block rounded-2xl py-2.5 text-base font-semibold transition hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-ink)]',
                      child.indent
                        ? 'pl-9 pr-4 text-sm text-[var(--color-ink-soft)]'
                        : 'px-4 text-[var(--color-ink-soft)]',
                    ]}
                    data-mobile-nav-link
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={withBase(item.href)}
              class="rounded-2xl px-4 py-3 text-lg font-semibold text-[var(--color-ink)] transition hover:bg-[var(--color-surface-muted)]"
              data-mobile-nav-link
            >
              {item.label}
            </a>
          ),
        )}
      </nav>

      <div class="h-px bg-[var(--color-border)]"></div>

      <a
        href={withBase('/tools')}
        class="rounded-2xl px-4 py-3 text-lg font-semibold text-[var(--color-ink)] transition hover:bg-[var(--color-surface-muted)]"
        data-mobile-nav-link
      >
        Tools &amp; Calculators
      </a>

      <a
        href={withBase('/capability-statement')}
        class="block rounded-full bg-[var(--color-secondary)] px-5 py-3 text-center text-base font-semibold !text-white shadow-sm transition hover:bg-[var(--color-primary)]"
        data-mobile-nav-link
        data-track-event="nav_cta_click"
        data-track-label="capability_statement"
      >
        {brand.ctas.secondary}
      </a>
    </div>
  </div>
</div>

<script is:inline>
  function initMobileNav() {
    document.querySelectorAll('[data-mobile-nav-root]').forEach(function (root) {
      if (!(root instanceof HTMLElement)) return;

      var panel = root.querySelector('[data-mobile-nav-panel]');
      var button = root.querySelector('[data-mobile-nav-toggle]');

      if (!(panel instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

      var topLine = button.querySelector('[data-mobile-nav-line="top"]');
      var middleLine = button.querySelector('[data-mobile-nav-line="middle"]');
      var bottomLine = button.querySelector('[data-mobile-nav-line="bottom"]');
      var closeButtons = panel.querySelectorAll('[data-mobile-nav-close], [data-mobile-nav-link]');

      function setOpen(open) {
        panel.classList.toggle('hidden', !open);
        button.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';

        if (topLine instanceof HTMLElement) {
          topLine.classList.toggle('translate-y-2', open);
          topLine.classList.toggle('rotate-45', open);
        }

        if (middleLine instanceof HTMLElement) {
          middleLine.classList.toggle('opacity-0', open);
        }

        if (bottomLine instanceof HTMLElement) {
          bottomLine.classList.toggle('-translate-y-2', open);
          bottomLine.classList.toggle('-rotate-45', open);
        }
      }

      button.addEventListener('click', function () {
        var currentlyOpen = button.getAttribute('aria-expanded') === 'true';
        setOpen(!currentlyOpen);
      });

      closeButtons.forEach(function (element) {
        element.addEventListener('click', function () { setOpen(false); });
      });

      panel.addEventListener('click', function (event) {
        if (event.target === panel) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          setOpen(false);
        }
      });

      // Collapsible group toggles
      root.querySelectorAll('[data-mobile-nav-group-toggle]').forEach(function (toggle) {
        toggle.addEventListener('click', function () {
          var expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          var groupPanel = toggle.parentElement.querySelector('[data-mobile-nav-group-panel]');
          if (groupPanel) groupPanel.classList.toggle('hidden');
          var chevron = toggle.querySelector('svg');
          if (chevron) chevron.classList.toggle('rotate-180');
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initMobileNav);
</script>
