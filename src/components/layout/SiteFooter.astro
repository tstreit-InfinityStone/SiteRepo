---
import { Image } from 'astro:assets';
import issLogoReversed from '@/assets/brand/iss-logo-reversed.png';
import { brand } from '@/data/brand';
import { contactNavigation, footerNavigation, legalNavigation } from '@/data/navigation';
import { withBase } from '@/lib/paths';
import { siteConfig } from '@/data/site';
import Container from '@/components/ui/Container.astro';
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-ink)] text-white">
  <Container className="grid gap-10 py-14 md:grid-cols-[1.3fr_0.6fr_0.5fr_0.5fr]">
    <div class="space-y-4">
      <Image src={issLogoReversed} alt={brand.name} class="h-36 w-auto" />
      <p class="max-w-xl text-base text-white/75">{siteConfig.footerSummary}</p>
      <div class="space-y-1 text-sm text-white/80">
        <p>{siteConfig.phone}</p>
        <p>{siteConfig.email}</p>
        <p>{siteConfig.location}</p>
      </div>
      <a
        href={withBase(brand.assets.capabilityStatement)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:text-[var(--color-accent)]"
        data-track-event="capability_statement_download"
        data-track-label="footer-pdf"
      >
        Download Capability Statement
      </a>
    </div>

    <div>
      <h2 class="text-lg text-white">Explore</h2>
      <ul class="mt-4 space-y-3">
        {footerNavigation.map((item) => (
          <li>
            <a href={withBase(item.href)} class="text-sm text-white/78 transition hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-lg text-white">Contact</h2>
      <ul class="mt-4 space-y-3">
        {contactNavigation.map((item) => (
          <li>
            <a href={withBase(item.href)} class="text-sm text-white/78 transition hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-lg text-white">Policies</h2>
      <ul class="mt-4 space-y-3">
        {legalNavigation.map((item) => (
          <li>
            <a href={withBase(item.href)} class="text-sm text-white/78 transition hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-white/60">
        &copy; {new Date().getFullYear()} {brand.shortName}. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
