---
import { Image } from 'astro:assets';
import issLogo from '@/assets/brand/iss-logo-transparent.png';
import { brand } from '@/data/brand';
import { mainNavigation } from '@/data/navigation';
import { stripBase, withBase } from '@/lib/paths';
import Container from '@/components/ui/Container.astro';
import MobileNav from '@/components/islands/MobileNav.astro';

const currentPath = stripBase(Astro.url.pathname);

function isActive(item: (typeof mainNavigation)[number]) {
  if (item.children) {
    return item.children.some(
      (child) => currentPath === child.href || (child.href !== '/' && currentPath.startsWith(child.href)),
    );
  }
  return currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
}
---

<header transition:name="site-header" class="sticky top-0 z-40 border-b border-[var(--color-border)]/70 bg-white/95 backdrop-blur">
  <Container className="flex min-h-[7rem] items-center justify-between gap-6">
    <a href={withBase('/')} class="flex items-center" aria-label={brand.name}>
      <Image src={issLogo} alt={brand.name} class="h-36 w-auto" loading="eager" fetchpriority="high" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {mainNavigation.map((item) =>
        item.children ? (
          <div class="group relative">
            <a
              href={withBase(item.href)}
              aria-current={isActive(item) ? 'page' : undefined}
              class="nav-link inline-flex items-center gap-1 text-center text-sm font-semibold text-[var(--color-ink)] transition hover:text-[var(--color-primary)]"
            >
              {item.label}
              <svg
                class="h-3.5 w-3.5 text-[var(--color-ink-soft)] transition-transform duration-200 group-hover:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100">
              <div class="min-w-[200px] rounded-2xl border border-[var(--color-border)] bg-white p-2 shadow-lg">
                {item.children.map((child) => (
                  <a
                    href={withBase(child.href)}
                    aria-current={
                      currentPath === child.href || (child.href !== '/' && currentPath.startsWith(child.href))
                        ? 'page'
                        : undefined
                    }
                    class:list={[
                      'block rounded-xl py-2.5 text-sm font-semibold transition hover:bg-[var(--color-surface)] hover:text-[var(--color-primary)]',
                      child.indent
                        ? 'ml-5 pl-4 pr-4 text-xs text-[var(--color-ink-soft)]'
                        : 'px-4 text-[var(--color-ink)]',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item) ? 'page' : undefined}
            class="nav-link text-center text-sm font-semibold text-[var(--color-ink)] transition hover:text-[var(--color-primary)]"
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <span class="h-5 w-px bg-[var(--color-border)]" aria-hidden="true"></span>
      <a
        href={withBase('/tools')}
        aria-current={currentPath.startsWith('/tools') ? 'page' : undefined}
        class="nav-link text-sm font-semibold text-[var(--color-ink)] transition hover:text-[var(--color-primary)]"
      >
        Tools &amp; Calculators
      </a>
    </div>

    <a
      href={withBase('/capability-statement')}
      class="hidden rounded-full bg-[var(--color-secondary)] px-5 py-2.5 text-sm font-semibold !text-white shadow-sm transition hover:bg-[var(--color-primary)] lg:inline-flex"
      data-track-event="nav_cta_click"
      data-track-label="capability_statement"
    >
      {brand.ctas.secondary}
    </a>

    <MobileNav items={mainNavigation} />
  </Container>
</header>
