---
import { credentials } from '@/data/credentials';
import { pastPerformanceHighlights } from '@/data/proof';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
---

<section class="section-space bg-white/80">
  <Container className="space-y-10">
    <SectionHeading
      title="On the record."
      description="ISS doesn't ask you to take our word for it. SAM registration, named agency engagements, and the professional credentials your evaluation requires — all verifiable, all documented."
    />

    <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-5">
        <div class="stagger-children grid gap-6 md:grid-cols-2">
          {pastPerformanceHighlights.map((item) => (
            <article class="panel fade-up p-6">
              <h2 class="text-2xl">{item.title}</h2>
              <p class="mt-3">{item.summary}</p>
            </article>
          ))}
        </div>
        <div class="flex justify-end">
          <a href="/case-studies" class="text-sm font-semibold text-[var(--color-secondary)] transition-colors hover:text-[var(--color-primary)]">
            View all case studies →
          </a>
        </div>
      </div>

      <div class="panel-muted p-6">
        <div class="mt-5 space-y-5">
          {credentials.map((credential) => (
            <div class="rounded-2xl border border-white/60 bg-white/80 p-4">
              <h2 class="text-xl">{credential.title}</h2>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{credential.shortDescription}</p>
              <p class="mt-2 text-sm font-semibold text-[var(--color-secondary)]">{credential.relevance}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
