---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getInsights } from '@/lib/content';
import { withBase } from '@/lib/paths';

const insights = await getInsights();
const featured = insights.slice(0, 3);
---

<section class="section-space">
  <Container className="space-y-10">
    <SectionHeading
      title="Insights for federal buyers"
      description="Practical guidance for contracting officers, program managers, and primes evaluating small IT partners."
    />

    <div class="section-grid stagger-children">
      {featured.map((insight) => (
        <a
          href={withBase(`/insights/${insight.id}`)}
          class="panel fade-up flex flex-col p-6 transition hover:shadow-lg"
        >
          <p class="text-xs font-semibold text-[var(--color-secondary)]">
            {insight.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
          <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">{insight.data.title}</h2>
          <p class="mt-3 flex-1 text-sm text-[var(--color-ink-soft)]">{insight.data.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)]">
            Read more
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>
