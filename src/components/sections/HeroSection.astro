---
import { Image } from 'astro:assets';
import issLogo from '@/assets/brand/iss-logo-transparent.png';
import { brand } from '@/data/brand';
import { siteConfig } from '@/data/site';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="section-space overflow-hidden">
  <Container>
    <div class="hero-grid">
      <div class="space-y-7">
        <div class="space-y-5">
          <h1 class="max-w-4xl text-5xl leading-tight md:text-6xl">{siteConfig.heroHeadline}</h1>
          <p class="max-w-2xl text-xl">{siteConfig.heroSubheadline}</p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" analyticsEvent="cta_click" analyticsLabel="hero-contact">
            {brand.ctas.primary}
          </Button>
          <Button
            href={brand.assets.capabilityStatement}
            variant="secondary"
            analyticsEvent="capability_statement_download"
            analyticsLabel="hero-pdf"
          >
            {brand.ctas.secondary}
          </Button>
        </div>
      </div>

      <aside class="panel-muted relative overflow-hidden p-8">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent" />
        <div class="mb-6 flex justify-center">
          <Image src={issLogo} alt="Infinity Stone Solutions" class="h-44 w-auto drop-shadow-sm" />
        </div>
        <p class="eyebrow">Why Procurement Starts Here</p>
        <div class="mt-5 space-y-5">
          {brand.trustBadges.map((badge) => (
            <div class="rounded-2xl border border-white/60 bg-white/75 p-4">
              <h2 class="text-lg">{badge.label}</h2>
              <p class="mt-2 text-sm">{badge.detail}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </Container>
</section>
