---
import Button from '@/components/ui/Button.astro';
---

<div class="mt-10 panel p-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
  <div class="max-w-xl">
    <h2 class="text-2xl">Ready to evaluate your options?</h2>
    <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
      Download our Capability Statement for procurement-ready detail, or start a conversation about your program needs.
    </p>
  </div>
  <div class="flex flex-col gap-3 sm:flex-row">
    <Button href="/capability-statement" variant="secondary">
      View Capability Statement
    </Button>
    <Button href="/contact" analyticsEvent="cta_click" analyticsLabel="insight-contact">
      Start a Capability Discussion
    </Button>
  </div>
</div>
