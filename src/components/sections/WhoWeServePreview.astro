---
import { sectors } from '@/data/sectors';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
---

<section class="section-space">
  <Container className="space-y-8">
    <SectionHeading
      title="Agencies and programs Infinity Stone Solutions supports"
      description="From SIGINT and missile-defense operations to Palantir-enabled digital forensics and enterprise cloud migrations — Infinity Stone Solutions has delivered in high-stakes programs where accountability is non-negotiable. That same discipline transfers to every engagement, federal or regulated private-sector."
    />

    <!-- Tab bar -->
    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Sectors">
      {sectors.map((sector, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-sector-tab={sector.id}
          class="rounded-full border border-[var(--color-border)] bg-white px-4 py-2 text-sm font-semibold text-[var(--color-ink-soft)] transition-all hover:border-[var(--color-secondary)] hover:text-[var(--color-secondary)] aria-selected:border-[var(--color-secondary)] aria-selected:bg-[var(--color-secondary)] aria-selected:!text-white"
        >
          {sector.title}
        </button>
      ))}
    </div>

    <!-- Content panels -->
    <div>
      {sectors.map((sector, i) => (
        <div
          role="tabpanel"
          data-sector-panel={sector.id}
          class={i !== 0 ? 'hidden' : ''}
        >
          <div class="panel p-8">
            <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
              <div>
                <h2 class="text-2xl font-semibold text-[var(--color-ink)]">{sector.title}</h2>
                <p class="mt-3 text-[var(--color-ink-soft)]">{sector.summary}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {sector.agencies.map((agency) => (
                    <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 font-mono text-xs font-semibold text-[var(--color-primary)]">
                      {agency}
                    </span>
                  ))}
                </div>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-[var(--color-ink-soft)]">Buyer concerns</p>
                <div class="mt-4 space-y-3">
                  {sector.buyerConcerns.map((concern) => (
                    <p class="flex items-start gap-3 text-sm">
                      <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
                      <span class="text-[var(--color-ink-soft)]">{concern}</span>
                    </p>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <Button href="/who-we-serve" variant="secondary">
      Explore who ISS supports
    </Button>
  </Container>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLElement>('[data-sector-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-sector-panel]');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-sector-tab');
        tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
        tab.setAttribute('aria-selected', 'true');
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-sector-panel') !== targetId);
        });
      });
    });
  });
</script>
