---
import type { CollectionEntry } from 'astro:content';

interface Props {
  capability: CollectionEntry<'capabilities'>;
}

const { capability } = Astro.props;
const firstOutcomes = capability.data.outcomes.slice(0, 2);
const extraOutcomes = capability.data.outcomes.slice(2);
const cardId = `card-${capability.id}`;
---

<article class="panel fade-up h-full" data-accordion-card>
  <button
    data-accordion-header
    aria-expanded="false"
    aria-controls={`${cardId}-body`}
    class="flex w-full items-start justify-between gap-4 p-6 text-left"
  >
    <div class="min-w-0">
      <h3 class="text-2xl">{capability.data.title}</h3>
    </div>
    <svg
      class="accordion-chevron h-5 w-5 flex-shrink-0 text-[var(--color-primary)]"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div class="px-6 pb-2">
    <p class="text-[var(--color-ink-soft)]">{capability.data.summary}</p>

    <div class="mt-5 space-y-2">
      {firstOutcomes.map((outcome) => (
        <p class="flex items-start gap-3 text-sm">
          <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
          <span>{outcome}</span>
        </p>
      ))}
    </div>
  </div>

  <div id={`${cardId}-body`} class="accordion-body" aria-hidden="true">
    <div class="overflow-hidden">
      <div class="space-y-6 px-6 pb-6 pt-4">
        {extraOutcomes.length > 0 && (
          <div class="space-y-2">
            {extraOutcomes.map((outcome) => (
              <p class="flex items-start gap-3 text-sm">
                <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
                <span>{outcome}</span>
              </p>
            ))}
          </div>
        )}

        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">Included work</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {capability.data.includedWork.map((item) => (
              <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-3">
                <p class="text-sm font-semibold text-[var(--color-ink)]">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <a
          href={`/capabilities/${capability.id}`}
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition hover:text-[var(--color-secondary)]"
        >
          Explore capability
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    document.querySelectorAll('[data-accordion-card]').forEach(function (card) {
      var header = card.querySelector('[data-accordion-header]');
      if (!header || header.hasAttribute('data-accordion-bound')) return;
      header.setAttribute('data-accordion-bound', '');

      header.addEventListener('click', function () {
        var expanded = header.getAttribute('aria-expanded') === 'true';
        var bodyId = header.getAttribute('aria-controls');
        var body = bodyId ? document.getElementById(bodyId) : null;
        var chevron = header.querySelector('.accordion-chevron');

        header.setAttribute('aria-expanded', expanded ? 'false' : 'true');

        if (body) {
          if (expanded) {
            body.classList.remove('is-open');
            body.setAttribute('aria-hidden', 'true');
          } else {
            body.classList.add('is-open');
            body.setAttribute('aria-hidden', 'false');
          }
        }

        if (chevron) {
          if (expanded) {
            chevron.classList.remove('is-open');
          } else {
            chevron.classList.add('is-open');
          }
        }
      });
    });
  });
</script>
