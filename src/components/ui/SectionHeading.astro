---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl';
---

<div class={`${alignment} fade-up`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg">{description}</p>}
</div>
