---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/data/site';
import { proofSignals } from '@/data/proof';
import { teamMembers } from '@/data/team';
import { buildBreadcrumbSchema, buildOrganizationSchema } from '@/lib/seo';
---

<BaseLayout
  title="About"
  description="Learn how Infinity Stone Solutions positions its work around mission support, modernization discipline, and practical delivery."
  canonicalPath="/about"
  structuredData={[
    buildOrganizationSchema(),
    buildBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
  ]}
>
  <PageHero
    title="A focused technology partner for mission-driven modernization and delivery support."
    description="The first-release About page keeps the story concise: what ISS is, how it works, and which proof signals best support its positioning."
  />

  <section class="section-space">
    <Container className="grid gap-10 xl:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-8">
        <article class="panel p-8">
          <p class="text-lg">{siteConfig.positioning}</p>
          <p class="mt-4">
            The public website experience is designed for buyers who need to move quickly from first impression to capability fit, not for visitors browsing generic marketing copy.
          </p>
        </article>

        <article class="panel p-8">
          <div class="space-y-3">
            {siteConfig.differentiators.map((item) => (
              <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
                <h2 class="text-xl">{item.title}</h2>
                <p class="mt-2 text-sm">{item.description}</p>
              </div>
            ))}
          </div>
        </article>
      </div>

      <div class="space-y-8">
        <article class="panel-muted p-8">
          <div class="space-y-4">
            {proofSignals.slice(0, 4).map((signal) => (
              <div class="rounded-2xl border border-white/70 bg-white/80 p-4">
                <h2 class="text-xl">{signal.label}</h2>
                <p class="mt-2 text-sm">{signal.shortDescription}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="panel p-8">
          <h2 class="mt-3 text-2xl">Need to assess fit for a program, modernization effort, or capability gap?</h2>
          <p class="mt-3">
            Start with the Capability Statement or contact ISS directly for a capability discussion.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <Button href="/capability-statement" variant="secondary">
              View Capability Statement
            </Button>
            <Button href="/contact" analyticsEvent="cta_click" analyticsLabel="about-contact">
              Contact ISS
            </Button>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <section class="section-space bg-[var(--color-surface)]">
    <Container className="space-y-10">
      <SectionHeading
        title="Our Leadership Team"
        description="ISS is led by professionals with firsthand experience in the programs they now support. Named delivery history and cleared backgrounds — not resumes built around titles."
      />
      <div class="grid gap-8 md:grid-cols-2">
        {teamMembers.map((member) => (
          <div>
            {member.image ? (
              <div class="mx-auto mb-6 w-3/4">
                <img
                  src={member.image}
                  alt={member.name}
                  width="800"
                  height="800"
                  class="aspect-square w-full rounded-2xl object-cover"
                />
              </div>
            ) : (
              <div class="mx-auto mb-6 flex aspect-square w-3/4 items-center justify-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-muted)]">
                <span class="text-6xl font-bold text-[var(--color-ink-soft)]">
                  {member.name.startsWith('[') ? '?' : member.name.split(' ').map((n) => n[0]).join('')}
                </span>
              </div>
            )}
          <article class="panel p-8">
            <div>
              <h2 class="text-xl font-semibold text-[var(--color-ink)]">{member.name}</h2>
              <p class="mt-1 text-sm font-semibold text-[var(--color-secondary)]">{member.title}</p>
            </div>
            {member.bio && (
              <p class="mt-5 text-[var(--color-ink-soft)]">{member.bio}</p>
            )}
            {member.background && (
              <p class="mt-3 font-mono text-xs text-[var(--color-primary)]">{member.background}</p>
            )}
            {member.credentials.length > 0 && (
              <div class="mt-5 space-y-2 border-t border-[var(--color-border)] pt-5">
                {member.credentials.map((c) => (
                  <p class="flex items-start gap-2 text-sm">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
                    <span class="text-[var(--color-ink-soft)]">{c}</span>
                  </p>
                ))}
              </div>
            )}
          </article>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
