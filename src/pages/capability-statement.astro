---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { brand } from '@/data/brand';
import { capabilityStatementData } from '@/data/capability-statement';
import { buildBreadcrumbSchema, buildOrganizationSchema } from '@/lib/seo';

const { registration, overview, competencies, differentiators, highlights, pastPerformance } = capabilityStatementData;
---

<BaseLayout
  title="Capability Statement"
  description="Infinity Stone Solutions — woman-veteran-owned technology firm. Federal registration details, NAICS codes, PSC codes, core competencies, and past performance for procurement review."
  canonicalPath="/capability-statement"
  structuredData={[
    buildOrganizationSchema(),
    buildBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Capability Statement', path: '/capability-statement' },
    ]),
  ]}
>
  <PageHero
    title="Federal contracting reference for procurement and acquisition teams."
    description="Registration details, NAICS and PSC codes, core competencies, differentiators, and past performance — in one procurement-ready document."
  />

  {/* Registration Banner */}
  <section class="section-space-tight">
    <Container>
      <div class="panel bg-[linear-gradient(135deg,var(--color-secondary),var(--color-primary))] p-8 text-white md:p-10">
        <div class="grid gap-8 md:grid-cols-3">
          {/* UEI / CAGE */}
          <div>
            <p class="eyebrow !text-white/60">UEI / CAGE</p>
            <p class="mt-2 font-display text-2xl font-bold tracking-tight text-white md:text-3xl">QMM4G5XMSMD7</p>
            <p class="mt-1 font-mono text-lg text-white/80">CAGE: 0B9Q0</p>
            <p class="mt-3 text-sm text-white/70">Active SAM registration — procurement-ready</p>
          </div>

          {/* Primary NAICS + Certifications */}
          <div>
            <p class="eyebrow !text-white/60">Primary NAICS</p>
            <p class="mt-2 font-display text-3xl font-bold text-white">{registration.primaryNaics}</p>
            <p class="mt-1 text-sm text-white/80">Computer Systems Design Services</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-white">WOSB</span>
              <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-white">SDVOSB</span>
              <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-white">SB</span>
            </div>
          </div>

          {/* Contact / SAM */}
          <div>
            <p class="eyebrow !text-white/60">Contract Contact</p>
            <div class="mt-3 space-y-2">
              <a href={`tel:${registration.phone}`} class="flex items-center gap-2 text-white transition hover:text-white/80">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="text-sm font-semibold">{registration.phone}</span>
              </a>
              <a href={`mailto:${registration.email}`} class="flex items-center gap-2 text-white transition hover:text-white/80">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="text-sm font-semibold">{registration.email}</span>
              </a>
              <a href={registration.samProfile} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-white transition hover:text-white/80">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span class="text-sm font-semibold">SAM.gov Profile</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* PDF Download Strip */}
  <section class="py-2 md:py-3">
    <Container>
      <div class="panel flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-secondary)]/10">
            <svg class="h-4 w-4 text-[var(--color-secondary)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </span>
          <div>
            <p class="font-semibold text-[var(--color-ink)]">ISS Capability Statement — PDF</p>
            <p class="text-sm">Formatted for offline review and acquisition files</p>
          </div>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <a
            href={brand.assets.capabilityStatement}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-shrink-0 items-center gap-2 rounded-full bg-[var(--color-secondary)] px-5 py-2.5 text-sm font-semibold !text-white transition hover:bg-[var(--color-primary)]"
            data-track-event="capability_statement_download"
            data-track-label="capability-page-full-pdf"
          >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Full Version
          </a>
          <a
            href={brand.assets.capabilityStatementOnePage}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-shrink-0 items-center gap-2 rounded-full border border-[var(--color-secondary)] px-5 py-2.5 text-sm font-semibold text-[var(--color-secondary)] transition hover:bg-[var(--color-secondary)] hover:!text-white"
            data-track-event="capability_statement_download"
            data-track-label="capability-page-onepage-pdf"
          >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            1-Page Summary
          </a>
        </div>
      </div>
    </Container>
  </section>

  {/* Main content */}
  <section class="section-space">
    <Container className="grid gap-10 xl:grid-cols-[1.15fr_0.85fr]">

      {/* LEFT COLUMN */}
      <div class="space-y-8">

        {/* Overview */}
        <article class="panel p-8">
          <p class="eyebrow">Company Overview</p>
          <p class="mt-4 text-lg leading-relaxed">{overview}</p>
        </article>

        {/* Core Competencies */}
        <article class="panel p-8">
          <p class="eyebrow">Core Competencies</p>
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {competencies.map((item) => (
              <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
                <h3 class="text-lg font-semibold text-[var(--color-ink)]">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </article>

        {/* Differentiators */}
        <article class="panel p-8">
          <p class="eyebrow">Differentiators</p>
          <div class="mt-5 space-y-3">
            {differentiators.map((item) => (
              <p class="flex items-start gap-3">
                <span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]" />
                <span class="text-[var(--color-ink-soft)]">{item}</span>
              </p>
            ))}
          </div>
        </article>

        {/* Past Performance */}
        <article class="panel p-8">
          <p class="eyebrow">Past Performance</p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">Click any engagement to view the full narrative.</p>
          <div class="mt-6 space-y-3">
            {pastPerformance.map((entry, i) => {
              const cardId = `pp-card-${i}`;
              return (
                <div data-accordion-card class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]">
                  <button
                    data-accordion-header
                    aria-expanded="false"
                    aria-controls={`${cardId}-body`}
                    class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left"
                  >
                    <h3 class="text-base font-semibold text-[var(--color-ink)]">{entry.client}</h3>
                    <svg
                      class="accordion-chevron h-5 w-5 flex-shrink-0 text-[var(--color-primary)]"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div id={`${cardId}-body`} class="accordion-body" aria-hidden="true">
                    <div class="overflow-hidden">
                      <p class="px-5 pb-5 text-sm leading-relaxed text-[var(--color-ink-soft)]">{entry.summary}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </article>

      </div>

      {/* RIGHT COLUMN */}
      <div class="space-y-8">

        {/* NAICS Codes */}
        <article class="panel p-8">
          <p class="eyebrow">NAICS Codes</p>
          <div class="mt-4 flex items-center gap-3">
            <span class="rounded-full bg-[var(--color-accent)] px-4 py-1.5 font-mono text-sm font-bold text-white">
              {registration.primaryNaics}
            </span>
            <span class="text-sm text-[var(--color-ink-soft)]">Computer Systems Design Services — Primary</span>
          </div>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[var(--color-border)]">
                  <th class="pb-2 pr-4 text-left font-semibold text-[var(--color-ink)]">Code</th>
                  <th class="pb-2 pr-4 text-left font-semibold text-[var(--color-ink)]">Description</th>
                </tr>
              </thead>
              <tbody>
                {registration.naicsWithDescriptions.filter((n) => n.code !== registration.primaryNaics).map((naics, i) => (
                  <tr class={`border-b border-[var(--color-border)]/50 ${i % 2 === 0 ? '' : 'bg-[var(--color-surface-muted)]/40'}`}>
                    <td class="py-2 pr-4 font-mono text-xs font-semibold text-[var(--color-primary)]">
                      {naics.code}
                    </td>
                    <td class="py-2 pr-2 text-[var(--color-ink-soft)]">{naics.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        {/* PSC Codes */}
        <article class="panel p-8">
          <p class="eyebrow">PSC Codes</p>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[var(--color-border)]">
                  <th class="pb-2 pr-4 text-left font-semibold text-[var(--color-ink)]">Code</th>
                  <th class="pb-2 text-left font-semibold text-[var(--color-ink)]">Description</th>
                </tr>
              </thead>
              <tbody>
                {registration.pscWithDescriptions.map((psc, i) => (
                  <tr class={`border-b border-[var(--color-border)]/50 ${i % 2 === 0 ? '' : 'bg-[var(--color-surface-muted)]/40'}`}>
                    <td class="py-2 pr-4 font-mono text-xs font-bold text-[var(--color-primary)]">
                      {psc.code}
                    </td>
                    <td class="py-2 text-[var(--color-ink-soft)]">{psc.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        {/* City of Denver NAICS / CIE Reference */}
        <article class="panel p-8">
          <p class="eyebrow">City of Denver — NAICS & CIE</p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
            Corresponding Index Entries (CIE) used by the City and County of Denver procurement system.
          </p>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[var(--color-border)]">
                  <th class="pb-2 pr-3 text-left font-semibold text-[var(--color-ink)]">NAICS</th>
                  <th class="pb-2 pr-3 text-left font-semibold text-[var(--color-ink)]">Description</th>
                  <th class="pb-2 text-left font-semibold text-[var(--color-ink)]">Index Entries</th>
                </tr>
              </thead>
              <tbody>
                {registration.naicsWithDescriptions.filter((n) => n.cie).map((naics, i) => (
                  <tr class={`border-b border-[var(--color-border)]/50 ${i % 2 === 0 ? '' : 'bg-[var(--color-surface-muted)]/40'}`}>
                    <td class="py-2 pr-3 font-mono text-xs font-semibold text-[var(--color-primary)]">{naics.code}</td>
                    <td class="py-2 pr-3 text-[var(--color-ink)]">{naics.description}</td>
                    <td class="py-2 text-xs text-[var(--color-ink-soft)]">{naics.cie}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>

        {/* Download + Highlights */}
        <article class="panel-muted p-8">
          <p class="eyebrow">Published Highlights</p>
          <div class="mt-5 space-y-4">
            {highlights.map((item) => (
              <div class="rounded-2xl border border-[var(--color-border)] bg-white/80 p-4">
                <h3 class="font-semibold text-[var(--color-ink)]">{item.title}</h3>
                <p class="mt-2 text-sm">{item.summary}</p>
              </div>
            ))}
          </div>
        </article>

      </div>
    </Container>
  </section>

  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      document.querySelectorAll('[data-accordion-card]').forEach(function (card) {
        var header = card.querySelector('[data-accordion-header]');
        if (!header || header.hasAttribute('data-accordion-bound')) return;
        header.setAttribute('data-accordion-bound', '');

        header.addEventListener('click', function () {
          var expanded = header.getAttribute('aria-expanded') === 'true';
          var bodyId = header.getAttribute('aria-controls');
          var body = bodyId ? document.getElementById(bodyId) : null;
          var chevron = header.querySelector('.accordion-chevron');

          header.setAttribute('aria-expanded', expanded ? 'false' : 'true');

          if (body) {
            if (expanded) {
              body.classList.remove('is-open');
              body.setAttribute('aria-hidden', 'true');
            } else {
              body.classList.add('is-open');
              body.setAttribute('aria-hidden', 'false');
            }
          }

          if (chevron) {
            if (expanded) {
              chevron.classList.remove('is-open');
            } else {
              chevron.classList.add('is-open');
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
