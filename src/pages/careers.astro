---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import FieldError from '@/components/form/FieldError.astro';
import FormScripts from '@/components/form/FormScripts.astro';
import FormStatusBanners from '@/components/form/FormStatusBanners.astro';
import HoneypotField from '@/components/form/HoneypotField.astro';
import PageHero from '@/components/ui/PageHero.astro';
import TurnstileWidget from '@/components/form/TurnstileWidget.astro';
import { withBase } from '@/lib/paths';
import { buildBreadcrumbSchema, buildOrganizationSchema } from '@/lib/seo';

const formEndpoint = withBase('/api/forms/careers');
---

<BaseLayout
  title="Careers"
  description="Join Infinity Stone Solutions — a woman-veteran-owned technology firm supporting federal missions. Submit your resume and we'll reach out when the right opportunity opens."
  canonicalPath="/careers"
  structuredData={[
    buildOrganizationSchema(),
    buildBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Careers', path: '/careers' },
    ]),
  ]}
>
  <PageHero
    title="Build something that matters."
    description="ISS isn't always hiring — but we're always looking for exceptional people. Submit your resume and we'll reach out when the right opportunity opens."
  />

  <section class="section-space">
    <Container className="grid gap-10 xl:grid-cols-[0.75fr_1.25fr]">
      <aside class="space-y-6">
        <article class="panel-muted p-8">
          <p class="eyebrow">Why ISS</p>
          <div class="mt-5 space-y-3">
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>Mission-driven work supporting federal agencies</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>Small-team culture</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>Room for growth across disciplines</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>Remote flexibility (some exclusions apply)</span>
            </p>
          </div>
        </article>

        <article class="panel p-8">
          <p class="eyebrow">What we look for</p>
          <div class="mt-5 space-y-3">
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-primary)]"></span>
              <span>Cleared or clearance-eligible professionals</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-primary)]"></span>
              <span>Experience in federal IT, cybersecurity, cloud, or analytics</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-primary)]"></span>
              <span>Self-starters who thrive in small, accountable teams</span>
            </p>
            <p class="flex items-start gap-3 text-sm">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-primary)]"></span>
              <span>People who care about the mission, not just the contract</span>
            </p>
          </div>
        </article>

        <article class="panel p-8">
          <p class="eyebrow">What to expect</p>
          <p class="mt-4">ISS reviews every submission. When a role opens that matches your background and experience, our team will reach out directly.</p>
          <p class="mt-4 text-sm">Include your background, areas of expertise, and any relevant certifications or clearances.</p>
        </article>
      </aside>

      <div class="panel-static self-start p-8" data-form-root>
        <FormStatusBanners successMessage="Thank you for your interest in ISS. We've received your resume and will be in touch if a role matches your background." />

        <form method="POST" action={formEndpoint} enctype="multipart/form-data" class="space-y-5" data-careers-form>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2 text-sm font-semibold text-[var(--color-ink)]">
              Full Name
              <input
                name="fullName"
                type="text"
                required
                class="w-full rounded-2xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)]"
              />
              <FieldError name="fullName" />
            </label>

            <label class="space-y-2 text-sm font-semibold text-[var(--color-ink)]">
              Email
              <input
                name="email"
                type="email"
                required
                class="w-full rounded-2xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)]"
              />
              <FieldError name="email" />
            </label>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2 text-sm font-semibold text-[var(--color-ink)]">
              Phone
              <input
                name="phone"
                type="tel"
                class="w-full rounded-2xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)]"
              />
              <FieldError name="phone" />
            </label>

            <label class="space-y-2 text-sm font-semibold text-[var(--color-ink)]">
              Area of Interest
              <select
                name="areaOfInterest"
                class="w-full rounded-2xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)]"
              >
                <option value="">Select an area</option>
                <option value="IT Modernization">IT Modernization</option>
                <option value="Cybersecurity">Cybersecurity</option>
                <option value="Cloud & Infrastructure">Cloud & Infrastructure</option>
                <option value="Data & Analytics">Data & Analytics</option>
                <option value="Program Support">Program Support</option>
                <option value="Other">Other</option>
              </select>
              <FieldError name="areaOfInterest" />
            </label>
          </div>

          <label class="space-y-3 text-sm font-semibold text-[var(--color-ink)]">
            Tell us about yourself
            <textarea
              name="message"
              required
              rows={6}
              class="mt-1 w-full rounded-3xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)]"
            />
            <FieldError name="message" />
          </label>

          <label class="space-y-2 text-sm font-semibold text-[var(--color-ink)]">
            Resume
            <span class="ml-1 font-normal text-[var(--color-ink-soft)]">(PDF or Word, max 10 MB)</span>
            <input
              name="resume"
              type="file"
              required
              accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              class="w-full rounded-2xl border border-[var(--color-border)] bg-white px-4 py-3 font-normal text-[var(--color-ink)] file:mr-4 file:rounded-full file:border-0 file:bg-[var(--color-primary)] file:px-4 file:py-1.5 file:text-sm file:font-semibold file:text-white hover:file:bg-[var(--color-secondary)]"
            />
            <FieldError name="resume" />
          </label>

          <HoneypotField />
          <TurnstileWidget tokenInputId="careersTurnstileToken" />

          <div class="flex justify-end">
            <Button type="submit" analyticsEvent="cta_click" analyticsLabel="careers-submit">
              Submit Application
            </Button>
          </div>
        </form>
      </div>
    </Container>
  </section>

  <FormScripts
    formSelector="[data-careers-form]"
    endpoint={formEndpoint}
    analyticsEvent="careers_form_success"
  />
</BaseLayout>
