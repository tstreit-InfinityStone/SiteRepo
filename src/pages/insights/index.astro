---
import { getCollection } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { buildOrganizationSchema } from '@/lib/seo';

const publishedInsights = (await getCollection('insights')).filter((entry) => !entry.data.draft);
---

<BaseLayout
  title="Insights"
  description="Future space for Infinity Stone Solutions insights and capability-led articles."
  canonicalPath="/insights"
  noindex={publishedInsights.length === 0}
  structuredData={buildOrganizationSchema()}
>
  <PageHero
    title="A future content area for capability-led insights."
    description="The route is scaffolded for future SEO and credibility growth, but it is intentionally kept out of the primary navigation until the content library is stronger."
  />

  <section class="section-space">
    <Container className="max-w-4xl">
      <div class="panel p-8">
        {publishedInsights.length > 0 ? (
          <div class="space-y-6">
            {publishedInsights.map((entry) => (
              <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
                <p class="eyebrow">{entry.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
                <h2 class="mt-3 text-2xl">{entry.data.title}</h2>
                <p class="mt-3">{entry.data.description}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="space-y-4">
            <h2 class="text-3xl">Insights are scaffolded, but not part of the first-release content requirement.</h2>
            <p>
              This route exists so future articles can be added through the content collection without changing the overall site architecture.
            </p>
          </div>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
