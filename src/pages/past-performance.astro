---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { caseStudies } from '@/data/case-studies';
import { buildBreadcrumbSchema, buildOrganizationSchema } from '@/lib/seo';
---

<BaseLayout
  title="Past Performance"
  description="Named past performance across defense, intelligence, law enforcement, and civilian federal programs. ISS has delivered at U.S. Navy, SPAWAR, ICE/HSI, and DOI/BLM."
  canonicalPath="/past-performance"
  structuredData={[
    buildOrganizationSchema(),
    buildBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Past Performance', path: '/past-performance' },
    ]),
  ]}
>
  <PageHero
    title="Past Performance"
    description="ISS has delivered across defense, intelligence, law enforcement, and civilian federal programs. The following engagements are named, documented, and verifiable."
  />

  <section class="section-space">
    <Container className="space-y-8">
      {caseStudies.map((study) => (
        <article class="panel fade-up p-8">
          <div class="grid gap-8 xl:grid-cols-[1.3fr_0.7fr]">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-2xl font-semibold text-[var(--color-ink)]">{study.client}</h2>
                <span class="rounded-full bg-[var(--color-surface-muted)] px-3 py-1 text-xs font-semibold text-[var(--color-ink-soft)]">{study.sector}</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {study.tags.map((tag) => (
                  <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 font-mono text-xs font-semibold text-[var(--color-primary)]">{tag}</span>
                ))}
              </div>
              <p class="mt-4 text-[var(--color-ink-soft)]">{study.summary}</p>
            </div>
            <div class="border-t border-[var(--color-border)] pt-6 xl:border-l xl:border-t-0 xl:pl-8 xl:pt-0">
              <p class="text-xs font-bold uppercase tracking-[0.15em] text-[var(--color-ink-soft)]">Outcomes</p>
              <ul class="mt-4 space-y-3">
                {study.outcomes.map((outcome) => (
                  <li class="flex items-start gap-3 text-sm">
                    <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                    <span class="text-[var(--color-ink-soft)]">{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </Container>
  </section>

  <section class="section-space bg-[var(--color-surface)]">
    <Container className="flex flex-col items-center gap-6 text-center">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Ready to discuss your program?</h2>
        <p class="mt-3 text-[var(--color-ink-soft)]">ISS brings named delivery history, dual socioeconomic certification, and a credentialed team to every engagement. Download the capability statement or start a capability discussion.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/capability-statement" variant="secondary">View Capability Statement</Button>
        <Button href="/contact" analyticsEvent="cta_click" analyticsLabel="case-studies-contact">Contact ISS</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
